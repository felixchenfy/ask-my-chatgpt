{
  "manifest_version": 3,
  "name": "WebContentAgent Chrome Companion",
  "version": "0.4.86",
  "description": "Runs approved local-agent workflows in the user's signed-in Chrome profile.",
  "permissions": ["alarms", "debugger", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.1point3acres.com/*",
    "https://www.google.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:18732/*",
    "http://127.0.0.1:18731/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "WebContentAgent Chrome Companion"
  }
}
