{
  "mcpServers": {
    "chatgpt_pdf_review": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "scripts\\launch-mcp.cmd"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH",
        "CHATGPT_PDF_REVIEW_CONFIG",
        "WCA_PROJECT_ROOT",
        "WCA_PYTHON_EXECUTABLE",
        "CHATGPT_BRIDGE_SOURCE"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600
    }
  }
}
